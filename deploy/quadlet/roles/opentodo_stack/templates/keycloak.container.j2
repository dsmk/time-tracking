# {{ ansible_managed }}
#
# Keycloak, brokering GitHub into OpenTodo's OIDC client.
#
# Started with `start` (not start-dev, and not --optimized): --optimized would
# need a custom image built with `kc.sh build`, and plain `start` augments at
# boot from the stock image. That costs a slow first start, which is why
# TimeoutStartSec is generous.
#
# Edge TLS termination, per Keycloak's reverse-proxy guide: HTTP on 8080,
# X-Forwarded-* trusted, and a full-URL hostname so the issuer string is
# absolute and stable.
[Unit]
Description=Keycloak for the OpenTodo stack
Requires={{ opentodo_network }}-network.service keycloak-postgres.service
After={{ opentodo_network }}-network.service keycloak-postgres.service

[Container]
ContainerName=keycloak
Image={{ keycloak_image }}
Network={{ opentodo_network }}.network
Exec=start --import-realm

Environment=KC_DB=postgres
Environment=KC_DB_URL=jdbc:postgresql://keycloak-postgres:5432/{{ keycloak_db_name }}
Environment=KC_DB_USERNAME={{ keycloak_db_user }}
# Must equal the "issuer" field of the discovery document, character for
# character, and therefore {{ opentodo_oidc_issuer }}.
Environment=KC_HOSTNAME=https://{{ opentodo_keycloak_host }}
Environment=KC_HTTP_ENABLED=true
Environment=KC_PROXY_HEADERS=xforwarded
Environment=KC_HEALTH_ENABLED=true
Environment=KC_METRICS_ENABLED=true
# A single instance, so there is no Infinispan cluster to form.
Environment=KC_CACHE=local
Environment=KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_admin_user }}

Secret={{ secret_prefix }}-postgres-password,type=env,target=KC_DB_PASSWORD
Secret={{ secret_prefix }}-keycloak-admin-password,type=env,target=KC_BOOTSTRAP_ADMIN_PASSWORD

# Rendered on the host by the same script the Kubernetes deployment uses.
# The file carries the client secrets; the directory around it is 0700
# root-owned on the host, so 0644 on the file only exposes it to the
# container that mounts it.
#
# Remember: --import-realm creates a realm that does not exist. It never
# updates one. Re-rendering this file changes nothing on a host that has
# already started once.
Volume={{ opentodo_config_dir }}/keycloak/import/realm.json:/opt/keycloak/data/import/realm.json:ro,Z

DropCapability=ALL
NoNewPrivileges=true

# The Keycloak image has no curl, so this is the usual bash/dev-tcp stand-in.
# Nothing depends on it; it is here so `podman ps` tells the truth.
HealthCmd=/bin/bash -c 'exec 3<>/dev/tcp/127.0.0.1/9000 && printf "GET /health/ready HTTP/1.0\r\n\r\n" >&3 && grep -q UP <&3'
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=120s

[Service]
Restart=on-failure
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
