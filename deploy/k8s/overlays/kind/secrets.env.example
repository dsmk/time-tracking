# kind/bootstrap.sh writes secrets.env for you with random values. This file
# documents what ends up in it, and is the template to copy if you would
# rather fill it in by hand.

OPENTODO_SETUP_TOKEN=change-me-at-least-16-chars
OIDC_CLIENT_SECRET=change-me
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me

# Password for the local Keycloak user named by DEV_USER in stack.env.
DEV_USER_PASSWORD=change-me

# Optional in kind. Leave empty and the realm is created with no identity
# provider, and you sign in with the local user above.
#
# To test the real GitHub bridge, register an OAuth app with callback URL
#   https://keycloak.kind.test/realms/opentodo/broker/github/endpoint
# GitHub does not check that the host resolves, and it never calls it itself —
# it redirects your browser there, which /etc/hosts already handles.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
