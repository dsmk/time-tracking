# kind overlay configuration.
#
# .test is a reserved TLD (RFC 6761), so these names can never collide with
# anything real and no resolver will try to look them up on the internet.
# They resolve in two different places, for two different clients:
#
#   your browser  -> 127.0.0.1 via /etc/hosts, where kind forwards :80/:443
#   OpenTodo's pod -> the ingress controller, via a CoreDNS rewrite that
#                     kind/bootstrap.sh installs
#
# Both have to work, because OIDC needs the browser to reach Keycloak *and*
# OpenTodo to fetch the discovery document and the token endpoint server to
# server — at the same issuer URL.
OPENTODO_BASE_URL=https://todo.kind.test

# The same two names without a scheme; kustomize copies them into the
# Ingresses so nothing can drift.
INGRESS_HOST_OPENTODO=todo.kind.test
INGRESS_HOST_KEYCLOAK=keycloak.kind.test

KC_HOSTNAME=https://keycloak.kind.test
KEYCLOAK_REALM=opentodo
OPENTODO_OIDC_ISSUER=https://keycloak.kind.test/realms/opentodo

OPENTODO_OIDC_CLIENT_ID=opentodo
OPENTODO_OIDC_DISPLAY_NAME=Keycloak

# A local Keycloak account, so the SSO path can be exercised end to end
# without registering a GitHub OAuth app. Remove these two lines (and
# DEV_USER_PASSWORD from secrets.env) to make the realm GitHub-only.
DEV_USER=tester
DEV_USER_EMAIL=tester@kind.test
