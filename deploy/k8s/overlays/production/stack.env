# Non-secret configuration for the production overlay. Edit the three
# hostnames; everything else is derived from them.
#
# Both names must resolve publicly and point at your ingress controller, and
# both must be covered by the certificates cert-manager issues.

# The https origin users reach OpenTodo on. Must match the Ingress host
# exactly, with no trailing slash. OpenTodo refuses sign-in with
# "cross-site request rejected" if this disagrees with the address in the
# browser.
OPENTODO_BASE_URL=https://todo.example.com

# The same two names without a scheme. kustomize copies these into the
# Ingress rules and TLS blocks, so the certificate, the route and the URLs
# above cannot drift apart. Change a hostname here and in the URLs, nowhere
# else. (If you enable keycloak-admin-ingress.yaml, set its host too.)
INGRESS_HOST_OPENTODO=todo.example.com
INGRESS_HOST_KEYCLOAK=keycloak.example.com

# Keycloak's public URL and the realm it serves.
KC_HOSTNAME=https://keycloak.example.com
KEYCLOAK_REALM=opentodo

# What OpenTodo discovers. This string must equal the "issuer" field of
# <issuer>/.well-known/openid-configuration character for character, which for
# Keycloak means <KC_HOSTNAME>/realms/<KEYCLOAK_REALM>.
OPENTODO_OIDC_ISSUER=https://keycloak.example.com/realms/opentodo

# The confidential client Keycloak creates for OpenTodo, and the label on
# OpenTodo's sign-in button.
OPENTODO_OIDC_CLIENT_ID=opentodo
OPENTODO_OIDC_DISPLAY_NAME=GitHub

# Forwarded headers are trusted from loopback, private and link-local
# addresses by default, which covers an in-cluster ingress controller. Set
# this when something else sits in front of it, e.g.:
#   OPENTODO_TRUSTED_PROXIES=cloudflare
# OPENTODO_TRUSTED_PROXIES=
