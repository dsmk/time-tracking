# Copy to secrets.env (gitignored) and fill in. Generate the three passwords
# with something like:
#
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40; echo
#
# secrets.env is read by kustomize at build time, so it must sit next to this
# file on the machine running `kubectl apply -k`. If you would rather not have
# plaintext there, delete the secretGenerator from kustomization.yaml and
# manage a Secret named `stack-secrets` however you already manage secrets
# (SOPS, Sealed Secrets, External Secrets, Vault ...). The key names below are
# the contract.

# Required by OpenTodo's setup screen for the very first account, because that
# request arrives through the ingress rather than from loopback. 16+
# characters. Ignored once the owner exists.
OPENTODO_SETUP_TOKEN=

# Shared between Keycloak's client definition and OPENTODO_OIDC_CLIENT_SECRET.
# Changing it later means changing it in both places; see the README.
OIDC_CLIENT_SECRET=

# Keycloak's first admin account, created only while no admin exists.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Password for the bundled PostgreSQL. Set before the first start; changing it
# afterwards also needs an ALTER ROLE inside the database.
POSTGRES_PASSWORD=

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
# Authorization callback URL must be exactly:
#   https://keycloak.example.com/realms/opentodo/broker/github/endpoint
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
