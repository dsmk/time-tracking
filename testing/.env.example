# Copy to `.env` and adjust. Every variable here is documented at
# https://open-todo.app/docs/self-hosting/docker/

# Host port to publish the server on (the container always uses 8080).
OPENTODO_PORT=8080

# Must match the address you actually open in a browser and give to `ot`.
OPENTODO_BASE_URL=http://localhost:8080

# Pin the image. `stable` moves with every release; `0.13.0` is one version.
OPENTODO_IMAGE_TAG=0.13.0
