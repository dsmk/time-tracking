# Two images from one file, sharing the same build of tt and ot.
#
#   --target toolbox   an interactive Toolbox/Distrobox for running tt and ot
#   --target test      a non-interactive image for scripted integration tests
#
# Build from the repository root, because the build needs tt's source:
#
#   podman build -f containers/Containerfile --target toolbox -t tt-toolbox .
#
# ./build.sh does that for you.

ARG FEDORA_VERSION=44
ARG GO_VERSION=1.26

# ---------------------------------------------------------------------------
# build — ot and tt, from one Go toolchain
# ---------------------------------------------------------------------------
#
# Both are Go programs, so one stage produces both binaries and the module
# cache is shared between them.
#
# NOTE the module path for ot. Upstream's documented command is
# `go install github.com/pixari/opentodo/cmd/ot@latest`, but the project's
# go.mod now declares `github.com/OpenTodoApp/opentodo`. Go refuses a module
# whose declared path differs from the one it was asked for, so the documented
# command fails and this one is used instead.
FROM docker.io/library/golang:${GO_VERSION} AS build
ARG OT_VERSION=v0.16.0
ARG TT_VERSION=v0.1.0
ENV CGO_ENABLED=0

# The ot version has to be stamped in, not just installed. cmd/ot/main.go
# declares `var version = "dev"` and upstream's Makefile overrides it with
# `-X main.version=`; a plain `go install` leaves it at "dev", `ot version
# --json` then reports {"version":"dev"}, and tt cannot parse that as a
# semver — so it prints "could not determine the OpenTodo client version"
# on every single command. Harmless, but it would make the image feel broken.
RUN go install -trimpath -ldflags="-s -w -X main.version=${OT_VERSION}" \
      "github.com/OpenTodoApp/opentodo/cmd/ot@${OT_VERSION}" \
    && /go/bin/ot version --json

WORKDIR /src
# go.sum is committed, so the module graph is the one CI builds with.
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go build -trimpath -ldflags="-s -w -X main.version=${TT_VERSION}" \
      -o /go/bin/tt ./cmd/tt \
    && /go/bin/tt --version

# ---------------------------------------------------------------------------
# toolbox — interactive
# ---------------------------------------------------------------------------
#
# Based on fedora-toolbox, which already carries everything toolbox(1) needs
# from an image. The label is what makes `toolbox create --image` accept it.
#
# Toolbox and Distrobox both share the host's network and bind-mount your
# home directory, which matters here: credentials set up on the host with
# deploy/bin/ot-credentials.sh (in ~/.config/opentodo) work unchanged inside,
# and a server on the host's localhost is reachable.
FROM registry.fedoraproject.org/fedora-toolbox:${FEDORA_VERSION} AS toolbox

LABEL com.github.containers.toolbox="true" \
      org.opencontainers.image.title="tt toolbox" \
      org.opencontainers.image.description="tt and the OpenTodo CLI, for interactive use" \
      org.opencontainers.image.source="https://github.com/dsmk/time-tracking"

# jq and GNU date are what testing/*.sh need; the rest of what those scripts
# use is already in the base image.
#
# golang is here so the toolbox can rebuild tt, which is most of the point of
# having one. Build with --build-arg TOOLBOX_EXTRA_PACKAGES="" to leave it out
# and save about 600 MB. Note that Fedora's Go is whatever that release ships,
# not the version pinned above.
ARG TOOLBOX_EXTRA_PACKAGES="golang"
RUN dnf -y install jq ${TOOLBOX_EXTRA_PACKAGES} \
    && dnf clean all \
    && rm -rf /var/cache/dnf

COPY --from=build /go/bin/ot /usr/local/bin/ot
COPY --from=build /go/bin/tt /usr/local/bin/tt

# ---------------------------------------------------------------------------
# test — scripted integration tests
# ---------------------------------------------------------------------------
#
# The repository is mounted at /work rather than copied in, so a run tests the
# working tree. The build and module caches live outside it so a container run
# never fights the host's own caches.
FROM docker.io/library/golang:${GO_VERSION} AS test

RUN apt-get update \
    && apt-get install -y --no-install-recommends jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /go/bin/ot /usr/local/bin/ot

# HOME is set away from /work because the container runs as the invoking user
# (--userns=keep-id), whose home does not exist inside the image: without this,
# the Go toolchain writes its telemetry counters into the mounted working tree.
ENV GOCACHE=/go-cache \
    GOMODCACHE=/go-mod \
    GOFLAGS=-mod=mod \
    HOME=/go-home
RUN mkdir -p /go-cache /go-mod /go-home && chmod 0777 /go-cache /go-mod /go-home

WORKDIR /work
COPY containers/test-entrypoint.sh /usr/local/bin/test-entrypoint
ENTRYPOINT ["/usr/local/bin/test-entrypoint"]
CMD ["all"]
